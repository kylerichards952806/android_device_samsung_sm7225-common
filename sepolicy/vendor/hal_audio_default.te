add_hwservice(hal_audio_default, hal_bluetooth_a2dp_hwservice)

r_dir_file(hal_audio_default, imei_efs_file)
r_dir_file(hal_audio_default, sec_efs_file)

allow hal_audio_default efs_file:dir search;

get_prop(hal_audio_default, vendor_radio_prop)

# ro.multisim*
dontaudit hal_audio_default { default_prop radio_prop }:file { getattr map open read };
allow hal_audio_default audio_efs_file:dir search;

# TAS25xx calibration data lives in /efs/tas25xx and is read by the audio HAL.
allow hal_audio_default audio_efs_file:file { getattr open read };

# /sys/class/audio/earjack/state - jack insertion is what tells the
# Samsung audio HAL to route to the 3.5 mm jack. The type was labelled
# but never granted, so every read was denied and the jack was dead.
allow hal_audio_default sysfs_audio_writable:file r_file_perms;
allow hal_audio_default sysfs:dir search;
