allow hal_thermal_default sysfs_thermal:file getattr;

allow hal_thermal_default sysfs_battery:dir search;
allow hal_thermal_default sysfs_battery:file { read open getattr };

allow hal_thermal_default sysfs_battery:lnk_file read;

allow hal_thermal_default sysfs_power_writable:file { read open };

allow hal_thermal_default hal_thermal_samsung_hwservice:hwservice_manager { add find };

allow hal_thermal_default fwk_camera_hwservice:hwservice_manager find;

binder_call(hal_thermal_default, cameraserver)

hal_client_domain(hal_thermal_default, hal_audio)
# QTI thermal HAL reads thermal zones, /proc/stat and soc info
allow hal_thermal_default sysfs_thermal:dir r_dir_perms;
allow hal_thermal_default sysfs_thermal:file r_file_perms;
allow hal_thermal_default proc_stat:file r_file_perms;
allow hal_thermal_default vendor_sysfs_public:dir search;
allow hal_thermal_default vendor_sysfs_public:file r_file_perms;
