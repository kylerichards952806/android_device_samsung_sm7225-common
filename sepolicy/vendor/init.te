allow init proc_last_kmsg:file { setattr };

# /sys/kernel/tracing
allow init debugfs_tracing_debug:dir { mounton };

# /mnt/vendor/efs
allow init efs_file:dir { mounton };
allow init sec_efs_file:dir mounton;

allow init spu_file:dir mounton;

allow init same_process_hal_file:file { execute };

allow init servicemanager:binder { call transfer };

allow init system_server:binder call;

# /sys/devices/system/cpu/*/cpufreq/*
allow init sysfs_devices_system_cpu:file rw_file_perms;

# /sys/devices/platform/soc/3d00000.qcom,kgsl-3d0/kgsl/kgsl-3d0/*
allow init vendor_sysfs_kgsl:dir r_dir_perms;
allow init vendor_sysfs_kgsl:file rw_file_perms;

# /sys/devices/platform/soc/*/devfreq/*
allow init vendor_sysfs_devfreq:dir r_dir_perms;
allow init vendor_sysfs_devfreq:file rw_file_perms;

# /dev/cpu_dma_latency
allow init vendor_latency_device:chr_file rw_file_perms;

# /sys/devices/virtual/input/*/enabled and touchscreen enable nodes
allow init sysfs_input:dir r_dir_perms;
allow init sysfs_input:file rw_file_perms;
allow init sysfs_sec_touchscreen:dir r_dir_perms;
allow init sysfs_sec_touchscreen:file rw_file_perms;
allow init sysfs_touchscreen_writable:dir r_dir_perms;
allow init sysfs_touchscreen_writable:file rw_file_perms;

dontaudit init vndbinder_device:chr_file { open read write map ioctl };
allow init vbmeta_block_device:lnk_file relabelto;
dontaudit init hal_light_service:service_manager add;
allow init hidl_base_hwservice:hwservice_manager add;
dontaudit init hidl_allocator_hwservice:hwservice_manager { add find };
dontaudit init default_android_hwservice:hwservice_manager { add find };

# vendor HAL binaries executed by init
allow init vendor_file:file execute;
dontaudit vendor_init default_prop:property_service set;
dontaudit vendor_init tmpfs:dir write;
dontaudit vendor_init cache_file:dir search;
dontaudit vendor_init cgroup:dir getattr;
dontaudit vendor_init vts_status_prop:file read;
dontaudit init sysfs:file write;
